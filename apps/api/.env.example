# 本地配置复制为 apps/api/.env；启动时自动加载，系统环境变量优先。
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Qwen3-ASR-Flash，北京地域
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_MODEL=qwen3-asr-flash

# 实时转写沿用 DASHSCOPE_API_KEY，默认由 DASHSCOPE_BASE_URL 推导同地域 WS 地址。
ASR_REALTIME_MODEL=qwen3-asr-flash-realtime
# 自定义代理或工作空间域名时可显式填写同地域 /api-ws/v1/realtime 地址。
# ASR_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# 出题与评估；接入前填写服务商实际地址及 Key。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-6-luna
