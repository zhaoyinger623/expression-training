{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@expression/api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "WEB_ORIGIN", "SQLITE_PATH", "DASHSCOPE_*", "ASR_MODEL", "LLM_*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@expression/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_API_BASE_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    }
  }
}
